# build artifacts
/bin/
/dist/

# runtime data (DB, build cache, known_hosts, master key)
/data/

# go toolchain (bootstrapped locally)
/.gocache/

# downloaded build tools (tailwind CLI, etc.)
/.toolcache/

# editor / OS
*.swp
.DS_Store

# secrets that must never be committed
*.pem
*.key
!third_party/**/*.key
