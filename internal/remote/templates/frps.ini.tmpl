[common]
bind_port = {{.BindPort}}
vhost_http_port = {{.VhostHTTPPort}}
{{if .Domain}}subdomain_host = {{.Domain}}{{end}}
dashboard_addr = 127.0.0.1
dashboard_port = {{.DashboardPort}}
